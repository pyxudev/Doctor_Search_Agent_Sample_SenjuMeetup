# LLM (SpaceXAI / xAI)
XAI_API_KEY=your_xai_api_key_here
LLM_MODEL=grok-4.5
LLM_BASE_URL=https://api.x.ai/v1

# Twilio (optional for PoC CLI mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Agent behavior
RESPONSE_TIMEOUT_SEC=120
RETRY_ATTEMPT=1
MAX_SEARCH_TIME_SEC=60
CONFIDENCE_THRESHOLD=0.95

# Logging
LOG_LEVEL=info

# Database
DATABASE_URL=sqlite:////app/data/healthcare.db

# Data paths
JSON_DATA_DIR=/app/data/json
JSON_WATCH_DIR=/app/data/json/incoming
SAMPLE_DATA_PATH=/app/data/json/sample_doctors.json
